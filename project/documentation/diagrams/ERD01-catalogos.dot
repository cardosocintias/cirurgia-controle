digraph ERD { graph [rankdir=LR, bgcolor="white",nodesep=0.5,ranksep=0.9,pad=0.2,splines=polyline]; node [shape=plain,fontname="Arial"]; edge [fontname="Arial",fontsize=11,color="#5b7d8b",arrowsize=0.8];
"unit" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#a8bcc7"><TR><TD BGCOLOR="#17394a"><FONT COLOR="white" POINT-SIZE="15"><B>unit</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fb"><FONT POINT-SIZE="12">PK unit_id : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fb"><FONT POINT-SIZE="12">code : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fb"><FONT POINT-SIZE="12">name : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fb"><FONT POINT-SIZE="12">city : TEXT</FONT></TD></TR></TABLE>>];
"specialty" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#a8bcc7"><TR><TD BGCOLOR="#17394a"><FONT COLOR="white" POINT-SIZE="15"><B>specialty</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fb"><FONT POINT-SIZE="12">PK specialty_id : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fb"><FONT POINT-SIZE="12">name : TEXT</FONT></TD></TR></TABLE>>];
"surgical_procedure" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#a8bcc7"><TR><TD BGCOLOR="#17394a"><FONT COLOR="white" POINT-SIZE="15"><B>surgical_procedure</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fb"><FONT POINT-SIZE="12">PK procedure_id : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fb"><FONT POINT-SIZE="12">FK specialty_id : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fb"><FONT POINT-SIZE="12">name : TEXT</FONT></TD></TR></TABLE>>];
"procedure_pricing" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#a8bcc7"><TR><TD BGCOLOR="#17394a"><FONT COLOR="white" POINT-SIZE="15"><B>procedure_pricing</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fb"><FONT POINT-SIZE="12">PK FK procedure_id : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fb"><FONT POINT-SIZE="12">pricing_model : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fb"><FONT POINT-SIZE="12">reference_price_cents : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fb"><FONT POINT-SIZE="12">price_origin : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fb"><FONT POINT-SIZE="12">country : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fb"><FONT POINT-SIZE="12">currency : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fb"><FONT POINT-SIZE="12">notes : TEXT</FONT></TD></TR></TABLE>>];
"unit_procedure_price" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#a8bcc7"><TR><TD BGCOLOR="#17394a"><FONT COLOR="white" POINT-SIZE="15"><B>unit_procedure_price</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fb"><FONT POINT-SIZE="12">PK FK unit_id : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fb"><FONT POINT-SIZE="12">PK FK procedure_id : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fb"><FONT POINT-SIZE="12">sale_price_cents : INTEGER</FONT></TD></TR></TABLE>>];
"specialty" -> "surgical_procedure" [label="specialty_id",dir=both,arrowtail="teetee",arrowhead="crowodot",taillabel="1",headlabel="0..N",labeldistance=2];
"surgical_procedure" -> "procedure_pricing" [label="procedure_id",dir=both,arrowtail="teetee",arrowhead="teeodot",taillabel="1",headlabel="0..1",labeldistance=2];
"surgical_procedure" -> "unit_procedure_price" [label="procedure_id",dir=both,arrowtail="teetee",arrowhead="crowodot",taillabel="1",headlabel="0..N",labeldistance=2];
"unit" -> "unit_procedure_price" [label="unit_id",dir=both,arrowtail="teetee",arrowhead="crowodot",taillabel="1",headlabel="0..N",labeldistance=2];
}