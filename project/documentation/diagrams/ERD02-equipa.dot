digraph ERD { graph [rankdir=LR, bgcolor="white",nodesep=0.5,ranksep=0.9,pad=0.2,splines=polyline]; node [shape=plain,fontname="Arial"]; edge [fontname="Arial",fontsize=11,color="#5b7d8b",arrowsize=0.8];
"doctor" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#a8bcc7"><TR><TD BGCOLOR="#17394a"><FONT COLOR="white" POINT-SIZE="15"><B>doctor</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fb"><FONT POINT-SIZE="12">PK doctor_id : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fb"><FONT POINT-SIZE="12">name : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fb"><FONT POINT-SIZE="12">registration : TEXT</FONT></TD></TR></TABLE>>];
"specialty" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#a8bcc7"><TR><TD BGCOLOR="#17394a"><FONT COLOR="white" POINT-SIZE="15"><B>specialty</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fb"><FONT POINT-SIZE="12">PK specialty_id : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fb"><FONT POINT-SIZE="12">name : TEXT</FONT></TD></TR></TABLE>>];
"doctor_specialty" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#a8bcc7"><TR><TD BGCOLOR="#17394a"><FONT COLOR="white" POINT-SIZE="15"><B>doctor_specialty</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fb"><FONT POINT-SIZE="12">PK FK doctor_id : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fb"><FONT POINT-SIZE="12">PK FK specialty_id : INTEGER</FONT></TD></TR></TABLE>>];
"unit" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#a8bcc7"><TR><TD BGCOLOR="#17394a"><FONT COLOR="white" POINT-SIZE="15"><B>unit</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fb"><FONT POINT-SIZE="12">PK unit_id : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fb"><FONT POINT-SIZE="12">code : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fb"><FONT POINT-SIZE="12">name : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fb"><FONT POINT-SIZE="12">city : TEXT</FONT></TD></TR></TABLE>>];
"doctor_unit" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#a8bcc7"><TR><TD BGCOLOR="#17394a"><FONT COLOR="white" POINT-SIZE="15"><B>doctor_unit</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fb"><FONT POINT-SIZE="12">PK FK doctor_id : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fb"><FONT POINT-SIZE="12">PK FK unit_id : INTEGER</FONT></TD></TR></TABLE>>];
"surgery_doctor" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#a8bcc7"><TR><TD BGCOLOR="#17394a"><FONT COLOR="white" POINT-SIZE="15"><B>surgery_doctor</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fb"><FONT POINT-SIZE="12">PK FK surgery_id : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fb"><FONT POINT-SIZE="12">PK FK doctor_id : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fb"><FONT POINT-SIZE="12">role : TEXT</FONT></TD></TR></TABLE>>];
"specialty" -> "doctor_specialty" [label="specialty_id",dir=both,arrowtail="teetee",arrowhead="crowodot",taillabel="1",headlabel="0..N",labeldistance=2];
"doctor" -> "doctor_specialty" [label="doctor_id",dir=both,arrowtail="teetee",arrowhead="crowodot",taillabel="1",headlabel="0..N",labeldistance=2];
