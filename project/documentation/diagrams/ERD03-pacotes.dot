digraph ERD { graph [rankdir=LR, bgcolor="white",nodesep=0.5,ranksep=0.9,pad=0.2,splines=polyline]; node [shape=plain,fontname="Arial"]; edge [fontname="Arial",fontsize=11,color="#5b7d8b",arrowsize=0.8];
"package" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#a8bcc7"><TR><TD BGCOLOR="#17394a"><FONT COLOR="white" POINT-SIZE="15"><B>package</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fb"><FONT POINT-SIZE="12">FK unit_id : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fb"><FONT POINT-SIZE="12">PK package_id : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fb"><FONT POINT-SIZE="12">FK procedure_id : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fb"><FONT POINT-SIZE="12">name : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fb"><FONT POINT-SIZE="12">sale_price_cents : INTEGER</FONT></TD></TR></TABLE>>];
"package_item" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#a8bcc7"><TR><TD BGCOLOR="#17394a"><FONT COLOR="white" POINT-SIZE="15"><B>package_item</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fb"><FONT POINT-SIZE="12">PK FK package_id : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fb"><FONT POINT-SIZE="12">PK FK item_id : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fb"><FONT POINT-SIZE="12">quantity : REAL</FONT></TD></TR></TABLE>>];
"item" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#a8bcc7"><TR><TD BGCOLOR="#17394a"><FONT COLOR="white" POINT-SIZE="15"><B>item</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fb"><FONT POINT-SIZE="12">PK item_id : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fb"><FONT POINT-SIZE="12">name : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fb"><FONT POINT-SIZE="12">category : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fb"><FONT POINT-SIZE="12">unit : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fb"><FONT POINT-SIZE="12">unit_cost_cents : INTEGER</FONT></TD></TR></TABLE>>];
"budget" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#a8bcc7"><TR><TD BGCOLOR="#17394a"><FONT COLOR="white" POINT-SIZE="15"><B>budget</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fb"><FONT POINT-SIZE="12">modality : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fb"><FONT POINT-SIZE="12">FK package_id : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fb"><FONT POINT-SIZE="12">PK budget_id : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fb"><FONT POINT-SIZE="12">FK surgery_id : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fb"><FONT POINT-SIZE="12">version : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fb"><FONT POINT-SIZE="12">status : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fb"><FONT POINT-SIZE="12">sale_price_cents : INTEGER</FONT></TD></TR></TABLE>>];
"item" -> "package_item" [label="item_id",dir=both,arrowtail="teetee",arrowhead="crowodot",taillabel="1",headlabel="0..N",labeldistance=2];
"package" -> "package_item" [label="package_id",dir=both,arrowtail="teetee",arrowhead="crowodot",taillabel="1",headlabel="0..N",labeldistance=2];
"package" -> "budget" [label="package_id",dir=both,arrowtail="odottee",arrowhead="crowodot",taillabel="0..1",headlabel="0..N",labeldistance=2];
}