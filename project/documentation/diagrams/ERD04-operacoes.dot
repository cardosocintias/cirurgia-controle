digraph ERD { graph [rankdir=LR, bgcolor="white",nodesep=0.5,ranksep=0.9,pad=0.2,splines=polyline]; node [shape=plain,fontname="Arial"]; edge [fontname="Arial",fontsize=11,color="#5b7d8b",arrowsize=0.8];
"patient" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#a8bcc7"><TR><TD BGCOLOR="#17394a"><FONT COLOR="white" POINT-SIZE="15"><B>patient</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fb"><FONT POINT-SIZE="12">PK patient_id : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fb"><FONT POINT-SIZE="12">name : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fb"><FONT POINT-SIZE="12">fictional_code : TEXT</FONT></TD></TR></TABLE>>];
"surgery" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#a8bcc7"><TR><TD BGCOLOR="#17394a"><FONT COLOR="white" POINT-SIZE="15"><B>surgery</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fb"><FONT POINT-SIZE="12">FK unit_id : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fb"><FONT POINT-SIZE="12">PK surgery_id : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fb"><FONT POINT-SIZE="12">FK patient_id : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fb"><FONT POINT-SIZE="12">FK procedure_id : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fb"><FONT POINT-SIZE="12">scheduled_at : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fb"><FONT POINT-SIZE="12">status : TEXT</FONT></TD></TR></TABLE>>];
"budget" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#a8bcc7"><TR><TD BGCOLOR="#17394a"><FONT COLOR="white" POINT-SIZE="15"><B>budget</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fb"><FONT POINT-SIZE="12">modality : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fb"><FONT POINT-SIZE="12">FK package_id : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fb"><FONT POINT-SIZE="12">PK budget_id : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fb"><FONT POINT-SIZE="12">FK surgery_id : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fb"><FONT POINT-SIZE="12">version : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fb"><FONT POINT-SIZE="12">status : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fb"><FONT POINT-SIZE="12">sale_price_cents : INTEGER</FONT></TD></TR></TABLE>>];
"budget_line" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#a8bcc7"><TR><TD BGCOLOR="#17394a"><FONT COLOR="white" POINT-SIZE="15"><B>budget_line</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fb"><FONT POINT-SIZE="12">PK FK budget_id : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fb"><FONT POINT-SIZE="12">PK FK item_id : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fb"><FONT POINT-SIZE="12">quantity : REAL</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fb"><FONT POINT-SIZE="12">unit_cost_cents : INTEGER</FONT></TD></TR></TABLE>>];
"consumption" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#a8bcc7"><TR><TD BGCOLOR="#17394a"><FONT COLOR="white" POINT-SIZE="15"><B>consumption</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fb"><FONT POINT-SIZE="12">PK consumption_id : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fb"><FONT POINT-SIZE="12">FK surgery_id : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fb"><FONT POINT-SIZE="12">FK item_id : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fb"><FONT POINT-SIZE="12">quantity : REAL</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fb"><FONT POINT-SIZE="12">unit_cost_cents : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fb"><FONT POINT-SIZE="12">reason : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fb"><FONT POINT-SIZE="12">recorded_at : TEXT</FONT></TD></TR></TABLE>>];
"item" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#a8bcc7"><TR><TD BGCOLOR="#17394a"><FONT COLOR="white" POINT-SIZE="15"><B>item</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fb"><FONT POINT-SIZE="12">PK item_id : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fb"><FONT POINT-SIZE="12">name : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fb"><FONT POINT-SIZE="12">category : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fb"><FONT POINT-SIZE="12">unit : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f9fb"><FONT POINT-SIZE="12">unit_cost_cents : INTEGER</FONT></TD></TR></TABLE>>];
"patient" -> "surgery" [label="patient_id",dir=both,arrowtail="teetee",arrowhead="crowodot",taillabel="1",headlabel="0..N",labeldistance=2];
"surgery" -> "budget" [label="surgery_id",dir=both,arrowtail="teetee",arrowhead="crowodot",taillabel="1",headlabel="0..N",labeldistance=2];
"item" -> "budget_line" [label="item_id",dir=both,arrowtail="teetee",arrowhead="crowodot",taillabel="1",headlabel="0..N",labeldistance=2];
"budget" -> "budget_line" [label="budget_id",dir=both,arrowtail="teetee",arrowhead="crowodot",taillabel="1",headlabel="0..N",labeldistance=2];
"item" -> "consumption" [label="item_id",dir=both,arrowtail="teetee",arrowhead="crowodot",taillabel="1",headlabel="0..N",labeldistance=2];
"surgery" -> "consumption" [label="surgery_id",dir=both,arrowtail="teetee",arrowhead="crowodot",taillabel="1",headlabel="0..N",labeldistance=2];
}